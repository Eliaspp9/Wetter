// Die Wetter-App bei Cloudflare: https://wetter.elias-ziegler.workers.dev
// Cloudflare veröffentlicht das bei jedem Push auf main von selbst (Workers Builds).
// site/worker.js: Sicherheitsregeln, App nur nach Anmeldung, /api/… -> Worker wetter-proxy (worker/kachelmann-proxy.js, eigener Worker).
// Ausgeliefert wird der Ordner außer dem, was in .assetsignore steht.
{
  "name": "wetter",
  "main": "site/worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "services": [{ "binding": "PROXY", "service": "wetter-proxy" }],
  // Zwischenspeicher für Radar und Wettermodell von GeoSphere (gleicher KV-Speicher wie beim Worker, Schlüssel gm:…)
  "kv_namespaces": [{ "binding": "GM", "id": "cff44aa6d92b4c548d1eb1c33423bd98" }],
  // KI von Cloudflare (Workers AI) für die Tipps des Tages
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true }
}
